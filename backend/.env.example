# ============================================================
# Modelo do arquivo .env  (copie este arquivo, renomeie a cópia para ".env"
# na MESMA pasta e preencha). O .env NUNCA vai pro GitHub.
# Na Vercel, essas mesmas variáveis vão em Settings > Environment Variables.
# ============================================================

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave publishable (pode ser pública): usada só pra ler a tabela "posts"
SUPABASE_KEY=sb_publishable_COLE_AQUI
# chave SECRETA (só backend!): usada pra ler/escrever a tabela "usuarios"
SUPABASE_SECRET_KEY=sb_secret_COLE_AQUI

# Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
# Cole o conteúdo INTEIRO do .json numa linha só, entre aspas SIMPLES (no .env).
# Na VERCEL cole SEM as aspas: começando em { e terminando em }.
# (Pra depurar na Vercel: API_DEBUG=1 mostra o tipo do erro na resposta. Remova depois.)
# (Local, se preferir: pode ser o caminho do arquivo, ex.: C:\chaves\biohub-firebase.json)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"biohub-lab","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'
